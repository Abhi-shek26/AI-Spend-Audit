# Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# AI
GEMINI_API_KEY=your_google_gemini_api_key_here

# Email (Resend)
# Get API key from https://resend.com
# For testing: only works with your registered email
# For production: verify a domain at https://resend.com/domains and update sender email in src/app/api/leads/save/route.ts
RESEND_API_KEY=your_resend_api_key_here

# Abuse Protection (hCaptcha)
# Get keys from https://dashboard.hcaptcha.com
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
